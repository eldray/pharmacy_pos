# Copy this file to .env and fill in real values. .env is never committed.
NODE_ENV=development

# PostgreSQL connection used by the Electron app and the standalone backend
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pharmacy_pos
DB_USER=postgres
DB_PASSWORD=
# Only for hosted databases that require TLS
DB_SSL=false

# Alternative to the DB_* settings above (Render, Supabase, etc.)
# DATABASE_URL=postgres://user:password@host:5432/pharmacy_pos

# Backend listener
PORT=5000
# Keep 127.0.0.1 unless other machines on the network must reach the API
HOST=0.0.0.0

# Token signing secret — REQUIRED. Must be at least 32 characters and unique
# per installation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Shown on the /api/health endpoint
APP_VERSION=1.0.0
