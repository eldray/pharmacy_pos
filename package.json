{
  "name": "pharmacy-pos",
  "version": "1.0.0",
  "description": "Pharmacy Point of Sale System",
  "main": "main.cjs",
  "author": {
    "name": "Emmanuel Appiah",
    "email": "emk.appiah@gmail.com"
  },
  "license": "ISC",
  "scripts": {
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run electron\"",
    "devs": "concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm start",
    "electron": "wait-on http://127.0.0.1:3000 && electron . --no-sandbox",
    "build:frontend": "cd frontend && npm run build",
    "prepare:backend": "node scripts/prepare-backend.cjs",
    "build:prepare": "npm run build:frontend && npm run prepare:backend",
    "build:win": "npm run build:prepare && electron-builder --win nsis --x64",
    "build:win-installer": "npm run build:win",
    "build:win-portable": "npm run build:prepare && electron-builder --win portable --x64",
    "build:win-dir": "npm run build:prepare && electron-builder --win --x64 --dir",
    "build:linux": "npm run build:prepare && electron-builder --linux --x64",
    "build:linux-deb": "npm run build:prepare && electron-builder --linux deb --x64",
    "build:linux-appimage": "npm run build:prepare && electron-builder --linux AppImage --x64",
    "build:mac": "npm run build:prepare && electron-builder --mac",
    "clean": "rimraf release dist build-staging frontend/dist",
    "clean:modules": "rimraf node_modules backend/node_modules frontend/node_modules",
    "clean:all": "npm run clean && npm run clean:modules",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^38.7.2",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.6.2",
    "rimraf": "^5.0.5",
    "wait-on": "^9.0.3"
  }
}
